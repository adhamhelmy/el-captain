generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  /// Set once the user follows the link in their verification email. Sign-in needs it.
  emailVerified    DateTime?
  name             String
  /// Members only; coaches keep theirs on the coach profile.
  phone            String?
  role             Role             @default(USER)
  /// Set by an admin. A suspended user can't sign in, and open sessions stop working at the next status check.
  suspendedAt      DateTime?
  favouriteSports  FavouriteSport[]
  authTokens       AuthToken[]
  clientProfile    ClientProfile?
  coachProfile     CoachProfile?
  /// Language for member emails, saved from the request each time a member books or sends a request.
  locale           String?
  venues           Venue[]
  coachedSessions  Session[]        @relation("CoachSessions")
  bookings         Booking[]
  sentRequests     PrivateRequest[] @relation("PrivateRequestsSent")
  receivedRequests PrivateRequest[] @relation("PrivateRequestsReceived")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum Role {
  ADMIN
  STUDIO
  COACH
  USER
}

/// A single-use link sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model ClientProfile {
  id                String  @id @default(cuid())
  studioName        String
  studioDescription String?
  city              String?
  logoUrl           String?
  website           String?
  instagram         String?
  phone             String?
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  id              String             @id @default(cuid())
  status          CoachStatus        @default(INCOMPLETE)
  submittedAt     DateTime?
  bio             String?
  city            String?
  photoPath       String?
  instagram       String?
  tiktok          String?
  phone           String?
  locale          String?
  /// Price (EGP) and length (minutes) of one private session. Members can request one only when both are set.
  privatePrice    Int?
  privateDuration Int?
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links           CoachLink[]
  certifications  Certification[]
  sports          CoachSport[]
  statusEvents    CoachStatusEvent[]
}

enum CoachStatus {
  INCOMPLETE
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model CoachLink {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  label          String
  url            String
  position       Int

  @@index([coachProfileId])
}

model Certification {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  title          String
  filePath       String
  fileName       String
  contentType    String
  size           Int
  createdAt      DateTime     @default(now())

  @@index([coachProfileId])
}

enum SportStatus {
  PENDING
  APPROVED
}

model Sport {
  id              String           @id @default(cuid())
  nameEn          String
  nameAr          String?
  key             String           @unique
  status          SportStatus      @default(APPROVED)
  createdById     String?
  coaches         CoachSport[]
  favouredBy      FavouriteSport[]
  sessions        Session[]
  privateRequests PrivateRequest[]
  createdAt       DateTime         @default(now())
}

model CoachSport {
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sportId        String
  sport          Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([coachProfileId, sportId])
}

/// A sport a member picked on their profile.
model FavouriteSport {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
}

/// One row per status change: the review history admins see.
model CoachStatusEvent {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  from           CoachStatus?
  to             CoachStatus
  reason         String?
  actorId        String
  createdAt      DateTime     @default(now())

  @@index([coachProfileId, createdAt])
}

enum SessionType {
  GROUP
  PRIVATE
}

enum SessionLevel {
  ALL_LEVELS
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum CancelledBy {
  MEMBER
  COACH
  ADMIN
}

enum PrivateRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// A place a coach trains at. Archived venues are hidden from new sessions but stay linked to old ones.
model Venue {
  id         String           @id @default(cuid())
  coachId    String
  coach      User             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String
  mapUrl     String?
  archivedAt DateTime?
  sessions   Session[]
  requests   PrivateRequest[]
  createdAt  DateTime         @default(now())

  @@index([coachId])
}

/// Something on the calendar: a group session anyone can book, or a private one made from an accepted request.
model Session {
  id           String          @id @default(cuid())
  coachId      String
  coach        User            @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  sportId      String
  sport        Sport           @relation(fields: [sportId], references: [id])
  venueId      String
  venue        Venue           @relation(fields: [venueId], references: [id])
  type         SessionType
  /// Group sessions only.
  level        SessionLevel?
  title        String
  description  String?
  startsAt     DateTime
  durationMin  Int
  price        Int
  /// Always 1 for private sessions.
  capacity     Int
  /// Shared by the copies made with "repeat weekly".
  seriesId     String?
  status       SessionStatus   @default(SCHEDULED)
  cancelledAt  DateTime?
  cancelReason String?
  bookings     Booking[]
  request      PrivateRequest?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([coachId, startsAt])
  @@index([status, startsAt])
}

/// A member's place in a session. Cancelling keeps the row; booking again reactivates it.
model Booking {
  id          String        @id @default(cuid())
  sessionId   String
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId    String
  member      User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(CONFIRMED)
  cancelledAt DateTime?
  cancelledBy CancelledBy?
  createdAt   DateTime      @default(now())

  @@unique([sessionId, memberId])
  @@index([memberId])
}

/// A member asking a coach for a one-to-one session. Accepting creates the private Session.
model PrivateRequest {
  id           String               @id @default(cuid())
  memberId     String
  member       User                 @relation("PrivateRequestsSent", fields: [memberId], references: [id], onDelete: Cascade)
  coachId      String
  coach        User                 @relation("PrivateRequestsReceived", fields: [coachId], references: [id], onDelete: Cascade)
  venueId      String
  venue        Venue                @relation(fields: [venueId], references: [id])
  sportId      String
  sport        Sport                @relation(fields: [sportId], references: [id])
  startsAt     DateTime
  /// Copied from the coach's settings when sent.
  durationMin  Int
  /// Copied from the coach's settings when sent.
  price        Int
  message      String?
  status       PrivateRequestStatus @default(PENDING)
  responseNote String?
  respondedAt  DateTime?
  sessionId    String?              @unique
  session      Session?             @relation(fields: [sessionId], references: [id])
  createdAt    DateTime             @default(now())

  @@index([coachId, status])
  @@index([memberId, status])
}
