generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  /// Set once the user follows the link in their verification email. Sign-in needs it.
  emailVerified   DateTime?
  name            String
  role            Role             @default(USER)
  authTokens      AuthToken[]
  clientProfile   ClientProfile?
  coachProfile    CoachProfile?
  bookings        Booking[]
  classes         Class[]
  sessionRequests SessionRequest[] @relation("SessionRequests")
  coachSessions   SessionRequest[] @relation("CoachSessions")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum Role {
  ADMIN
  STUDIO
  COACH
  USER
}

/// A single-use link sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model ClientProfile {
  id                String  @id @default(cuid())
  studioName        String
  studioDescription String?
  city              String?
  logoUrl           String?
  website           String?
  instagram         String?
  phone             String?
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  id             String             @id @default(cuid())
  status         CoachStatus        @default(INCOMPLETE)
  submittedAt    DateTime?
  bio            String?
  city           String?
  photoPath      String?
  instagram      String?
  tiktok         String?
  phone          String?
  locale         String?
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links          CoachLink[]
  certifications Certification[]
  sports         CoachSport[]
  statusEvents   CoachStatusEvent[]
}

enum CoachStatus {
  INCOMPLETE
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model CoachLink {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  label          String
  url            String
  position       Int

  @@index([coachProfileId])
}

model Certification {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  title          String
  filePath       String
  fileName       String
  contentType    String
  size           Int
  createdAt      DateTime     @default(now())

  @@index([coachProfileId])
}

enum SportStatus {
  PENDING
  APPROVED
}

model Sport {
  id          String       @id @default(cuid())
  nameEn      String
  nameAr      String?
  key         String       @unique
  status      SportStatus  @default(APPROVED)
  createdById String?
  coaches     CoachSport[]
  createdAt   DateTime     @default(now())
}

model CoachSport {
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sportId        String
  sport          Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([coachProfileId, sportId])
}

/// One row per status change: the review history admins see.
model CoachStatusEvent {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  from           CoachStatus?
  to             CoachStatus
  reason         String?
  actorId        String
  createdAt      DateTime     @default(now())

  @@index([coachProfileId, createdAt])
}

model Class {
  id              String    @id @default(cuid())
  title           String
  type            String
  description     String?
  date            DateTime
  durationMinutes Int
  city            String
  address         String
  capacity        Int
  spotsLeft       Int
  imageUrl        String?
  clientId        String
  client          User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Booking {
  id        String        @id @default(cuid())
  status    BookingStatus @default(CONFIRMED)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, classId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model SessionRequest {
  id        String               @id @default(cuid())
  message   String
  status    SessionRequestStatus @default(PENDING)
  userId    String
  user      User                 @relation("SessionRequests", fields: [userId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User                 @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

enum SessionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}
