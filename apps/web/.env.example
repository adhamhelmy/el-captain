# Supabase pooler URL (port 6543) — used at runtime
DATABASE_URL=""

# Supabase direct URL (port 5432) — used for migrations only
DIRECT_URL=""

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# next-auth takes its base URL from the request host, so any port/domain works (Vercel does this automatically).
AUTH_TRUST_HOST=true

# Public base URL for links in emails (verification, password reset). Falls back to
# Vercel's production URL. Never taken from the request, so links can't be pointed elsewhere.
APP_URL="http://localhost:3000"

# Email through Resend (resend.com). Leave empty in local dev: emails are printed to the server console instead.
RESEND_API_KEY=""
# Sender, on a domain verified in Resend, e.g. "El Captain <no-reply@el-captain.app>"
MAIL_FROM=""
