      },
      "types": {
        "q": "إيه الفرق بين التمارين الجماعية والفردية؟",
        "a": "التمارين الجماعية ليها ميعاد ثابت وعدد محدود. التمارين الفردية بتبقى إنت والمدرب لوحدكم والوقت كله محجوز ليك."
      },
      "becomeCoach": {
        "q": "إزاي أبقى مدرب؟",
        "a": "سجّل كمدرب وكمّل البروفايل بتاعك. فريقنا بيراجع الطلبات، عادةً خلال يومين شغل."
      },
      "payouts": {
        "q": "المدربين بيقبضوا إزاي؟",
        "a": "الفلوس بتتحوّل كل أسبوع على الحساب اللي في بروفايل المدرب، بعد خصم رسوم المنصة."
      },
      "fee": {
        "q": "فيه اشتراك؟",
        "a": "لأ. الأعضاء بيدفعوا بالتمرين، والمدربين بيدفعوا نسبة بس على الحجوزات اللي اتمّت."
